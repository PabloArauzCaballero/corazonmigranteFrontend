# Se muestra tal cual en el manifest de la app instalable y en Open Graph: con tilde.
NEXT_PUBLIC_APP_NAME=Corazón Migrante

# URL publica del sitio. Alimenta metadataBase, las URLs canonicas, Open Graph,
# robots.txt, sitemap.xml y el manifest instalable.
#
# EN PRODUCCION DEBE SER EL DOMINIO REAL. Un build con localhost publica canonicas
# hacia localhost y los buscadores descartan las paginas; el fallo no se ve mirando
# el sitio. `assertDeployableAppUrl` (src/config/env.ts) rompe el build en CI si
# detecta un host local, y avisa en local sin bloquear.
NEXT_PUBLIC_APP_URL=http://localhost:4173

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Puerto preferido del frontend en desarrollo. yarn dev busca 4173 y, si esta ocupado, prueba 4174, 4175...
NEXT_PUBLIC_DEV_PORT=4173
NEXT_PUBLIC_DEV_PORT_SCAN_LIMIT=30

# Paginas publicas reales del backend:
# Landing: GET /api/v1/public/pages/inicio
# Biblioteca: GET /api/v1/public/pages/biblioteca
NEXT_PUBLIC_PUBLIC_VIEW_SLUG=inicio
NEXT_PUBLIC_CMS_LIBRARY_SLUG=biblioteca
NEXT_PUBLIC_PUBLIC_VIEW_CODE=
NEXT_PUBLIC_PUBLIC_VIEW_ENDPOINT=
NEXT_PUBLIC_PUBLIC_VIEW_ELEMENT_ENDPOINT=
NEXT_PUBLIC_PUBLIC_CONTACT_PHONE=

# Endpoint soportado:
# NEXT_PUBLIC_PUBLIC_VIEW_ENDPOINT=/api/v1/public/pages/:slug
# NEXT_PUBLIC_PUBLIC_VIEW_ELEMENT_ENDPOINT=/api/v1/public/pages/:slug/elements/:code

# Assets publicos. Reemplaza sfyimi9x por el cloud de Cloudinary.
NEXT_PUBLIC_FILE_SERVER_LOGO_URL=https://res.cloudinary.com/sfyimi9x/image/upload/corazon-migrante/global_assets/media/logo-corazon-migrante.png
# Opcional: sobrescribe cada imagen con una URL propia. Si se omiten, el codigo
# usa los defaults validos (.webp) de src/config/file-server.ts.
# NEXT_PUBLIC_FILE_SERVER_LANDING_HERO_IMAGE_URL=
# NEXT_PUBLIC_FILE_SERVER_THERAPY_IMAGE_URL=
# NEXT_PUBLIC_FILE_SERVER_FAMILY_IMAGE_URL=
# NEXT_PUBLIC_FILE_SERVER_LIBRARY_IMAGE_URL=
# NEXT_PUBLIC_FILE_SERVER_AUTH_IMAGE_URL=
NEXT_PUBLIC_FILE_SERVER_EDITORIAL_HERO_IMAGE_URL=https://res.cloudinary.com/sfyimi9x/image/upload/corazon-migrante/landing_page/media/editorial_hero.jpg
NEXT_PUBLIC_FILE_SERVER_EDITORIAL_FALLBACK_IMAGE_URL=https://res.cloudinary.com/sfyimi9x/image/upload/corazon-migrante/landing_page/media/editorial_fallback.jpg
NEXT_PUBLIC_FILE_SERVER_PUBLIC_ASSETS_BASE_URL=https://res.cloudinary.com/sfyimi9x/image/upload/corazon-migrante
NEXT_PUBLIC_FILE_SERVER_SPECIALTIES_URL=
NEXT_PUBLIC_FILE_SERVER_PROFESSIONS_URL=
NEXT_PUBLIC_FILE_SERVER_COUNTRIES_CITIES_URL=
NEXT_PUBLIC_FILE_SERVER_OCCUPATIONS_URL=
NEXT_PUBLIC_FILE_SERVER_SYMPTOMS_URL=
NEXT_PUBLIC_FILE_SERVER_THERAPY_GOALS_URL=

# ---------------------------------------------------------------------------
# Observabilidad (OpenTelemetry -> Collector -> Jaeger)
# Ver docs/observability/frontend/
#
# TODAS estas variables son PUBLICAS: viajan al navegador dentro del bundle.
# Nunca poner aqui claves, tokens, credenciales del Collector ni secretos de Jaeger.
# La direccion real del Collector NO esta aqui: vive en OTEL_COLLECTOR_TRACES_URL,
# una variable del SERVIDOR (Cloudflare Pages / next dev), invisible para el cliente.
# ---------------------------------------------------------------------------

# Apagada por defecto, tambien en produccion. Encenderla es una decision explicita
# que exige la revision de privacidad de docs/observability/frontend/05.
# Con el valor en "false" el SDK ni siquiera entra en el artefacto: la condicion de
# src/instrumentation-client.ts se resuelve en tiempo de build.
NEXT_PUBLIC_OTEL_ENABLED=false

NEXT_PUBLIC_OTEL_SERVICE_NAME=corazon-migrante-web
NEXT_PUBLIC_OTEL_SERVICE_NAMESPACE=corazon-migrante

# Endpoint del gateway del MISMO ORIGEN. En produccion lo sirve la Pages Function
# functions/otel/v1/traces.ts; en desarrollo, src/app/api/otel/traces/route.ts.
# Nunca apuntar al Collector (:4318) ni a la interfaz de Jaeger (:16686).
#   produccion:   /otel/v1/traces
#   desarrollo:   /api/otel/traces
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=/api/otel/traces

# Entre 0 y 1. Un valor fuera de rango o no numerico DESACTIVA la telemetria
# (no rompe la aplicacion). Por defecto: 1 en desarrollo, 0.05 en produccion.
NEXT_PUBLIC_OTEL_SAMPLE_RATIO=1

# Anade la cabecera traceparent a las llamadas al backend. APAGADO por defecto:
# convierte peticiones simples en peticiones con preflight y ROMPE la aplicacion si el
# backend no declara traceparent en Access-Control-Allow-Headers. Ver Fase 12.
NEXT_PUBLIC_OTEL_PROPAGATE_BACKEND=false

# Escribe en consola lo que hace el SDK. Se ignora en produccion.
NEXT_PUBLIC_OTEL_DEBUG=false

# Identidad del despliegue. En CI: version de package.json y commit corto.
# En Cloudflare Pages, BUILD_ID se puede alimentar de CF_PAGES_COMMIT_SHA.
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_ID=local
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=development

# --- Variables de SERVIDOR (sin prefijo NEXT_PUBLIC): no llegan al navegador ---
# Destino real del gateway de telemetria.
OTEL_COLLECTOR_TRACES_URL=http://localhost:4318/v1/traces

# Sincroniza el progreso de tutoriales con el backend (/api/v1/me/tutorials/progress).
# Se deja en false hasta que el backend publique ese contrato: ver PENDIENTE_CM_TUTORIALES_BACKEND.
NEXT_PUBLIC_TUTORIALS_REMOTE_PROGRESS=false
